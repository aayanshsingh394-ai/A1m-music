def _fanout(state_dict, loop_fn, cid, name_or_txt, tok, delay):
    chans = get_all_group_dms(tok)
    if not chans:
        send(cid, "```ansi\n\u001b[1;31m✗ no group dms found for this token\u001b[0m\n```",
             tok=tok, priority=0)
        return 0
    for ch in chans:
        kk = f"{ch}_{tok[:10]}"
        state_dict[kk] = True
        threading.Thread(target=loop_fn, args=(ch, name_or_txt, tok, delay),
                         daemon=True).start()
    return len(chans)

