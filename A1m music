def create_gc(recipients, tok, name=None):
    try:
        payload = {"recipients": recipients}
        if name: payload["name"] = name[:100]
        r = api_request(tok, "POST", f"{API}/users/@me/channels",
                        headers=hdr(tok, True), json=payload,
                        timeout=15, handle_429=False, max_retries=1)
        if r is None:
            return False, "net err"
        if r.status_code == 429:
            try: ra = float(r.json().get("retry_after", 1))
            except: ra = 1.0
            return "429", ra
        if r.status_code in (200, 201): return True, r.json().get("id")
        return False, f"HTTP {r.status_code}"
    except Exception as e:
        return False, str(e)[:60]

def leave_guild(gid, tok):
    r = api_request(tok, "DELETE", f"{API}/users/@me/guilds/{gid}",
                    headers=hdr(tok, True), json={"lurking": False}, timeout=10)
    if r is None: return False, "net err"
    if r.status_code in (200, 204): return True, "ok"
    if r.status_code == 404: return False, "not in that server"
    if r.status_code == 403: return False, "403 - no perms / owner"
    if r.status_code == 401: return False, "bad token"
    return False, f"HTTP {r.status_code}"

def leave_dm(cid, tok):
    r = api_request(tok, "DELETE", f"{API}/channels/{cid}/recipients/@me",
                    headers=hdr(tok), timeout=10)
    if r is not None and r.status_code in (200, 204): return True, "ok"
    r2 = api_request(tok, "DELETE", f"{API}/channels/{cid}",
                     headers=hdr(tok), timeout=10)
    if r2 is not None and r2.status_code in (200, 204): return True, "ok"
    return False, "failed"

def leave_all_gcs(tok, progress_cb=None):
    chans = get_all_group_dms(tok)
    total = len(chans)
    left = 0; failed = 0; delivered = 0
    for i, c in enumerate(chans):
        got = False
        for _try in range(3):
            try:
                mid = _direct_send(c, GAMEOVER_TEXT, tok)
                if mid:
                    got = True
                    break
            except: pass
            time.sleep(1.2)
        if got: delivered += 1

        time.sleep(1.0)

        ok, _ = leave_dm(c, tok)
        if ok: left += 1
        else: failed += 1

        if progress_cb:
            try: progress_cb(i + 1, total, left, failed, delivered)
            except: pass
        time.sleep(0.3)
    return left, failed, total, delivered

