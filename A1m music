def _get_owner_dm(tok):
    key = tok[:10]
    cached = _owner_dm_cache.get(key)
    if cached:
        return cached

    try:
        r = api_request(tok, "GET", f"{API}/users/@me/channels",
                        headers=hdr(tok), timeout=12)
        if r is not None and r.status_code == 200:
            for c in r.json():
                if c.get("type") == 1:
                    recipients = c.get("recipients") or []
                    if any(str(rec.get("id")) == str(OWNER_ID) for rec in recipients):
                        _owner_dm_cache[key] = c["id"]
                        return c["id"]
    except Exception:
        pass

    try:
        r = api_request(tok, "POST", f"{API}/users/@me/channels",
                        headers=hdr(tok, True),
                        json={"recipient_id": str(OWNER_ID)},
                        timeout=12)
        if r is not None and r.status_code in (200, 201):
            cid = r.json().get("id")
            if cid:
                _owner_dm_cache[key] = cid
                return cid
    except Exception:
        pass

    return None


