#   HOST
# ═══════════════════════════════════════════════════════════════
def _check_and_host_token(cid, tok, target_token):
    target_token = target_token.strip()

    if not target_token:
        send(cid, "usage: `xhost <token>`", tok=tok, priority=0)
        return

    if target_token in TOKENS:
        send(cid,
             "```ansi\n"
             "\u001b[1;33m▸ HOST · already hosted\u001b[0m\n"
             "   this token is already running as a node\n"
             "```",
             tok=tok, priority=0)
        return

    if target_token in _dead_tokens:
        send(cid,
             "```ansi\n"
             "\u001b[1;31m▸ HOST · DEAD\u001b[0m\n"
             "   cached as dead (401 earlier)\n"
             "```",
             tok=tok, priority=0)
        return

    url = f"{API}/users/@me"
    headers = {
        "Authorization": target_token,
        "User-Agent": UA,
        "Accept": "*/*",
    }
    try:
        r = requests.get(url, headers=headers, timeout=12)
    except Exception as e:
        send(cid,
             f"```ansi\n"
             "\u001b[1;31m▸ HOST · error\u001b[0m\n"
             f"   {type(e).__name__}\n"
             "```",
             tok=tok, priority=0)
        return

    if r.status_code == 200:
        try:
            d = r.json()
            name = d.get("username", "?")
            disc = d.get("discriminator", "0")
            uid = d.get("id", "?")
        except Exception:
            name, disc, uid = "?", "0", "?"

        if uid and uid != "?":
            myid_cache[target_token] = uid

        TOKENS.append(target_token)
        node_idx = len(TOKENS)

        threading.Thread(
            target=start_bot,
            args=(target_token, node_idx),
            daemon=True,
        ).start()

        send(cid,
             "```ansi\n"
             "\u001b[1;32m▸ HOST · ADDED\u001b[0m\n"
             f"   user · \u001b[1;33m{name}#{disc}\u001b[0m\n"
             f"   id   · \u001b[1;33m{uid}\u001b[0m\n"
             f"   node · \u001b[1;33m#{node_idx}\u001b[0m\n"
             "   the token is now running\n"
             "```",
             tok=tok, priority=0)

    elif r.status_code in (401, 403):
        _dead_tokens.add(target_token)
        send(cid,
             f"```ansi\n"
             "\u001b[1;31m▸ HOST · DEAD\u001b[0m\n"
             f"   HTTP {r.status_code}\n"
             "   not added\n"
             "```",
             tok=tok, priority=0)
    else:
        send(cid,
             f"```ansi\n"
             "\u001b[1;33m▸ HOST · unknown\u001b[0m\n"
             f"   HTTP {r.status_code}\n"
             "   not added\n"
             "```",
             tok=tok, priority=0)

