RATE_LIMIT_BUFFER = 1.5
MAX_RETRIES = 12

_route_rl = {}
_route_rl_lock = threading.Lock()
_global_rl_until = [0.0]
_global_rl_lock = threading.Lock()
_dead_tokens = set()

def _route_key(tok, method, path):
    parts = path.rstrip("/").split("/")
    for anchor, sub in (("channels", "CH"), ("guilds", "GD"),
                        ("messages", "MSG"), ("webhooks", "WH"),
                        ("users", "US"), ("invites", "IV"),
                        ("relationships", "RL")):
        if anchor in parts:
            i = parts.index(anchor)
            if i + 1 < len(parts) and parts[i+1]:
                parts[i+1] = sub
    return f"{tok[:12]}:{method}:/{'/'.join(parts)}"

def _set_route_gate(key, until):
    with _route_rl_lock:
        cur = _route_rl.get(key, 0.0)
        if until > cur:
            _route_rl[key] = until

def _get_route_gate(key):
    with _route_rl_lock:
        return _route_rl.get(key, 0.0)

def _bump_global(until):
    with _global_rl_lock:
        if until > _global_rl_until[0]:
            _global_rl_until[0] = until

def _get_global():
    with _global_rl_lock:
        return _global_rl_until[0]

def rl_snapshot():
    now = time.time()
    with _route_rl_lock:
        hot = sum(1 for v in _route_rl.values() if v > now)
    with _global_rl_lock:
        g = max(0.0, _global_rl_until[0] - now)
    with _nc_wall_lock:
        wall = max(0.0, _nc_wall_until[0] - now)
    return {"hot_routes": hot, "global_wait": g,
            "dead_tokens": len(_dead_tokens), "nc_wall_wait": wall}

def _trigger_nc_wall(tok, server_wait):
    now = time.time()
    with _nc_wall_lock:
        target = now + NC_WALL_COOLDOWN
        if target > _nc_wall_until[0]:
            _nc_wall_until[0] = target
        already = _nc_wall_alerted[0]
        _nc_wall_alerted[0] = True

    if already:
        return

    cid = _nc_origin_chan.get(tok[:10])
    if cid:
        send(
            cid,
            "```ansi\n"
            "\u001b[1;31m▸ NC WALL · ALL GCNC DOWN\u001b[0m\n"
            f"   server hold · \u001b[1;33m{server_wait:.0f}s\u001b[0m\n"
            f"   our pause   · \u001b[1;33m{NC_WALL_COOLDOWN:.0f}s\u001b[0m\n"
            "   \u001b[0;37mevery nc / customnc in every channel resumes after cooldown\u001b[0m\n"
            "```",
            tok=tok, priority=0,
        )

    def _reset():
        time.sleep(NC_WALL_COOLDOWN + 1.0)
        with _nc_wall_lock:
            _nc_wall_alerted[0] = False

    threading.Thread(target=_reset, daemon=True).start()


def _nc_wall_wait(k):
    now = time.time()
    if now < _nc_wall_until[0]:
        return True
    return False


def api_request(tok, method, url, max_retries=MAX_RETRIES,
                handle_429=True, **kwargs):
    path = url.replace(API, "") or url
    key = _route_key(tok, method, path)
    timeout = kwargs.pop("timeout", 15)

    if tok in _dead_tokens:
        return None

    for attempt in range(max_retries):
        now = time.time()

        gu = _get_global()
        if gu > now:
            time.sleep(min(0.5, gu - now))

        rg = _get_route_gate(key)
        if rg > time.time():
            time.sleep(min(0.35, rg - time.time()))

        try:
            r = get_session(tok).request(method, url, timeout=timeout, **kwargs)

            if r.status_code == 429:
                try:
                    data = r.json()
                    wait = float(data.get("retry_after", 0.5))
                    is_global = bool(data.get("global", False))
                except Exception:
                    wait = 0.5
                    is_global = False

                buffered = wait * RATE_LIMIT_BUFFER + random.uniform(0.2, 0.5)
                _set_route_gate(key, time.time() + buffered)
                if is_global:
                    _bump_global(time.time() + buffered)

                if (method == "PATCH"
                        and "/channels/" in path
                        and wait >= NC_WALL_TRIGGER):
                    _trigger_nc_wall(tok, wait)

                if not handle_429:
                    return r

                time.sleep(wait * 0.4 + random.uniform(0.1, 0.3))
                continue

            if r.status_code == 401:
                _dead_tokens.add(tok)
                _set_route_gate(key, time.time() + 5.0)
                time.sleep(0.3)
                continue

            if r.status_code == 403:
                _set_route_gate(key, time.time() + 5.0)
                time.sleep(0.3)
                continue

            _set_route_gate(key, time.time() + 0.05)
            return r

        except Exception:
            time.sleep(0.2)

    return None

