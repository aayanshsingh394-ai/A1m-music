def _fmt_duration(seconds):
    try:
        s = int(max(0, seconds))
    except Exception:
        s = 0
    d = s // 86400
    h = (s % 86400) // 3600
    m = (s % 3600) // 60
    sec = s % 60
    parts = []
    if d > 0: parts.append(f"{d}d")
    if h > 0: parts.append(f"{h}h")
    if m > 0: parts.append(f"{m}m")
    parts.append(f"{sec}s")
    return " ".join(parts)

