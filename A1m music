def _register_auto(tok, atype, target, delay, flexible=False):
    key = tok[:10]
    lst = auto_attacks.setdefault(key, [])
    lst[:] = [a for a in lst if a[0] != atype]
    lst.append((atype, target, delay, flexible))

def _clear_auto(tok, atype=None):
    key = tok[:10]
    if key not in auto_attacks: return
    if atype is None:
        auto_attacks.pop(key, None)
    else:
        auto_attacks[key] = [a for a in auto_attacks[key] if a[0] != atype]

def _start_attack(atype, chan, target, tok, delay=None):
    k = f"{chan}_{tok[:10]}"
    if atype == "nc":
        nc_on[k] = True
        threading.Thread(target=do_nc, args=(chan, target, tok, delay), daemon=True).start()
    elif atype == "spam":
        spam_on[k] = True
        threading.Thread(target=do_spam, args=(chan, target, tok, delay), daemon=True).start()
    elif atype == "spam3":
        spam3_on[k] = True
        threading.Thread(target=do_spam3, args=(chan, target, tok, delay), daemon=True).start()

def _run_auto_attacks(tok, gc_id):
    for entry in list(auto_attacks.get(tok[:10], [])):
        atype, target, delay, flexible = entry
        resolved = delay

        if atype == "nc":
            try:
                count = len(get_all_group_dms(tok))
            except Exception:
                count = 1

            if flexible:
                if delay is not None and count <= NC_CUSTOM_DELAY_MAX_GC:
                    resolved = delay
                else:
                    resolved = nc_delay_for_count(count)
            else:
                if delay is not None:
                    resolved = delay
                else:
                    resolved = nc_delay_for_count(count)

        _start_attack(atype, gc_id, target, tok, resolved)

