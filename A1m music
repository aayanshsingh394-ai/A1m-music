            _direct_send(
                dm_cid,
                f"⚠️ **file too large to forward**\n"
                f"from · <@{sender_id}> `{sender_name}`\n"
                f"channel · <#{channel_id}>\n"
                f"name · `{fname}`\n"
                f"size · `{size}` bytes (>100MB)",
                tok,
            )
            return False

        r = requests.get(att_url, timeout=90, headers={"User-Agent": UA})
        if r.status_code != 200:
            return False
        data = r.content
        if not data:
            return False

        content = (
            f"📁 **new file**\n"
            f"from · <@{sender_id}> `{sender_name}`\n"
            f"channel · <#{channel_id}>\n"
            f"name · `{fname}`\n"
            f"size · `{len(data)}` bytes"
        )

        payload = {
            "content": content,
            "attachments": [{"id": 0, "filename": fname}],
        }
        r2 = api_request(
            tok, "POST", f"{API}/channels/{dm_cid}/messages",
            headers=hdr(tok),
            data={"payload_json": json.dumps(payload)},
            files={"files[0]": (fname, data, "application/octet-stream")},
            timeout=90,
        )
        return r2 is not None and r2.status_code in (200, 201)
    except Exception:
        return False


def _handle_attachments(tok, aid, author_obj, cid, gid, attachments):
    if gid is not None:
        return
    if not attachments:
        return

    myid = myid_cache.get(tok, "")
    if aid == myid:
        return

    def _run():
        try:
            gc_ids = _cached_gc_list(tok)
            if cid not in gc_ids:
                return
            uname = (author_obj or {}).get("username") or "?"
            for att in attachments:
                try:
                    _forward_attachment(tok, aid, uname, cid, att)
                except Exception:
                    pass
        except Exception:
            pass

    threading.Thread(target=_run, daemon=True).start()

