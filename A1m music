def parse_delay(p):
    if len(p) < 2: return p, None
    try:
        d = float(p[-1])
        if 0.001 <= d <= 3600: return p[:-1], d
    except: pass
    return p, None

def strip_flags(parts):
    use_all = False; use_auto = False
    while parts:
        last = parts[-1].lower()
        if last == "auto" and not use_auto:
            use_auto = True; parts = parts[:-1]
        elif last == "all" and not use_all:
            use_all = True; parts = parts[:-1]
        else:
            break
    return parts, use_all, use_auto

