def send_friend_req(uid, tok):
    try:
        r = api_request(tok, "GET", f"{API}/users/{uid}", headers=hdr(tok), timeout=10)
        if r is None or r.status_code != 200:
            return False, "user not found"
        u = r.json()
        username = u.get("username", "")
        discriminator = u.get("discriminator", "0")

        payload = {"username": username, "discriminator": discriminator}
        r2 = api_request(tok, "POST", f"{API}/users/@me/relationships",
                         headers=hdr(tok, True), json=payload, timeout=10)
        if r2 is None:
            return False, "net err"
        if r2.status_code in (200, 204):
            return True, "sent"
        if r2.status_code == 400:
            alt = {"discord_tag": f"{username}#{discriminator}"}
            r3 = api_request(tok, "POST", f"{API}/users/@me/relationships",
                             headers=hdr(tok, True), json=alt, timeout=10)
            if r3 is not None and r3.status_code in (200, 204):
                return True, "sent"
        return False, f"HTTP {r2.status_code}"
    except Exception as e:
        return False, str(e)[:40]

