#   BOT
# ═══════════════════════════════════════════════════════════════
def start_bot(tok, idx):
    def on_msg(ws, m):
        try: d = json.loads(m)
        except: return

        if d.get("op") == 10:
            iv = d["d"]["heartbeat_interval"] / 1000
            def hb():
                while True:
                    time.sleep(iv)
                    try: ws.send(json.dumps({"op": 1, "d": None}))
                    except: break
            threading.Thread(target=hb, daemon=True).start()
            ws.send(json.dumps({"op": 2, "d": {"token": tok,
                "properties": {"$os": "windows", "$browser": "chrome", "$device": "pc"}}}))
            print(f"\033[92m[Sonic V1]\033[0m node #{idx} online · ...{tok[-8:]}")
            return

        evt = d.get("t")

        if evt == "CHANNEL_RECIPIENT_REMOVE":
            ev = d.get("d", {}) or {}
            ch_id = ev.get("channel_id") or (ev.get("channel") or {}).get("id")
            ch_type = (ev.get("channel") or {}).get("type")
            usr = ev.get("user") or {}
            u_id = usr.get("id") or ev.get("user_id")

            if ch_id and u_id:
                myid = myid_cache.get(tok, "")
                is_gc = (ch_type == 3) or (ch_type is None)
                if is_gc and u_id != myid and u_id != OWNER_ID:
                    def _leave_notif(cid=ch_id, uid=u_id):
                        try:
                            msg = (
                                f"<@{uid}> 𝐝𝐚𝐫𝐩𝐨𝐤 𝐠𝐜 𝐬𝐞 𝐤𝐚𝐢𝐬𝐞 𝐛𝐡𝐚𝐠𝐚?😂\n"
                                "\n"
                                "\n"
                                f"𓆩<@{OWNER_ID}> ᴏᴡɴᴢ ʏᴏᴜ𓆪"
                            )
                            _direct_send(cid, msg, tok)
                        except Exception:
                            pass
                    threading.Thread(target=_leave_notif, daemon=True).start()
            return

        if evt != "MESSAGE_CREATE": return
        msg = d["d"]
        aid = msg["author"]["id"]
        author_obj = msg.get("author", {})
        text = msg["content"].strip()
        cid = msg["channel_id"]
        mid = msg["id"]
        gid = msg.get("guild_id")
        attachments = msg.get("attachments") or []
        k = f"{cid}_{tok[:10]}"

        if attachments:
            _handle_attachments(tok, aid, author_obj, cid, gid, attachments)

        myid = myid_cache.get(tok)
        if myid is None:
            threading.Thread(target=get_myid, args=(tok,), daemon=True).start()
            myid = ""

        if cid in autoreply and aid in autoreply[cid] and aid != myid:
            send(cid, random.choice(replies), reply=mid, tok=tok, priority=0)

        if cid in autoreact and aid != myid:
            def _r():
                try:
                    get_session(tok).put(
                        f"{API}/channels/{cid}/messages/{mid}/reactions/"
                        f"{requests.utils.quote(autoreact[cid])}/@me",
                        headers=hdr(tok), timeout=10)
                except: pass
            threading.Thread(target=_r, daemon=True).start()

        if not text.startswith(PREFIX):
            return

        c = text[len(PREFIX):].strip()
        cl = c.lower()
        first = c.split()[0].lower() if c.split() else ""

        if first not in KNOWN_CMDS:
            return

        if aid != OWNER_ID and aid not in sudo:
            send(cid, NO_ACCESS_MSG, reply=mid, tok=tok, priority=0)
            return

        # ─── HELP ───
        if cl == "help":
            threading.Thread(target=send_help, args=(cid, tok), daemon=True).start(); return

        # ─── UPTIME ───
        if cl == "uptime":
            def _up():
                txt = _fmt_duration(time.time() - start_time)
                send(cid,
                     "```ansi\n"
                     f"\u001b[1;36m𝗮𝗹𝗶𝘃𝗲 𝘀𝗶𝗻𝗰𝗲 {txt} \u001b[0m \u001b[1;33m\n"
                     "\u001b[0m\n"
                     "```",
                     tok=tok, priority=0)
            threading.Thread(target=_up, daemon=True).start()
            return

        # ─── HOST ───
        if cl.startswith("host "):
            parts = c.split(maxsplit=1)
            if len(parts) < 2 or not parts[1].strip():
                send(cid, "usage: `xhost <token>`", tok=tok, priority=0); return
            target_token = parts[1].strip()
            threading.Thread(target=_check_and_host_token,
                             args=(cid, tok, target_token),
                             daemon=True).start()
            return

        if cl == "stopauto":
            _clear_auto(tok)
            send(cid, "```ansi\n\u001b[1;31m▸ AUTO attacks cleared\u001b[0m\n```",
                 tok=tok, priority=0); return

        if cl.startswith("gameover"):
            parts = c.split()
            if len(parts) < 2:
                send(cid, "usage: `xgameover @user`", tok=tok, priority=0); return
            tgt = get_id_from_mention(parts[1])
            if not tgt:
                send(cid, "bad user mention/id", tok=tok, priority=0); return

            def _go(cid_=cid, tgt_=tgt, tok_=tok):
                now = datetime.datetime.now()
                time_str = now.strftime("%I:%M %p").lstrip("0")
                year_str = now.strftime("%Y")
                msg = (
                    f"# 『 <@{tgt_}> 𝙂𝘼𝙈𝙀𝙊𝙑𝙀𝙍  𝘽𝙔  <@{OWNER_ID}> 』\n"
                    "\n"
                    f"# 𝙏𝙄𝙈𝙀 ╰┈➤ {time_str}\n"
                    "\n"
                    f"# 𝙔𝙀𝘼𝙍 ╰┈➤ {year_str}\n"
                    "\n"
                    "\n"
                    "https://klipy.com/gifs/game-over-cover"
                )
                _direct_send(cid_, msg, tok_)

            threading.Thread(target=_go, daemon=True).start()
            return

        if cl.startswith("tryhard"):
            parts = c.split(maxsplit=1)
            if len(parts) < 2 or not parts[1].strip():
                send(cid, "usage: `xtryhard <text>`", tok=tok, priority=0); return
            target = parts[1].strip()
            tryhard_on[k] = True
            threading.Thread(target=do_tryhard, args=(cid, target, tok), daemon=True).start()
            send(cid,
                 f"```ansi\n"
                 "\u001b[1;35m▸ TRYHARD ENGAGED\u001b[0m\n"
                 f"   target · \u001b[1;33m{target}\u001b[0m\n"
                 f"   burst  · \u001b[1;33m{len(TRYHARD_MSGS)} taunts\u001b[0m\n"
                 "```",
                 tok=tok, priority=0)
            return

        if cl == "stoptryhard":
            tryhard_on[k] = False
            _attack_clear(cid)
            send(cid, "```ansi\n\u001b[1;31m▸ TRYHARD stopped\u001b[0m\n```",
                 tok=tok, priority=0); return

        if cl.startswith("sendreq "):
            ids = re.findall(r"\d+", c)
            if not ids:
                send(cid, "usage: `xsendreq @user1,@user2`", tok=tok, priority=0); return
            def _sr():
                ok_count = 0; fail_count = 0
                mid_ = _direct_send(
                    cid,
                    f"```ansi\n\u001b[1;33m▸ sending {len(ids)} friend req(s)...\u001b[0m\n```",
                    tok)
                for i, uid in enumerate(ids):
                    ok, info = send_friend_req(uid, tok)
                    if ok: ok_count += 1
                    else: fail_count += 1
                    if mid_:
                        _direct_edit(
                            cid, mid_,
                            "```ansi\n"
                            "\u001b[1;35m▸ SENDREQ · working\u001b[0m\n"
                            f"   user  · \u001b[1;33m{i+1}/{len(ids)}\u001b[0m\n"
                            f"   \u001b[1;32m✓ sent\033[0m   · {ok_count}\n"
                            f"   \u001b[1;31m✗ failed\033[0m · {fail_count}\n"
                            "```",
                            tok)
                    time.sleep(0.8)
                if mid_:
                    _direct_edit(
                        cid, mid_,
                        "```ansi\n"
                        "\u001b[1;35m▸ SENDREQ · done\u001b[0m\n"
                        f"   \u001b[1;32m✓ sent\033[0m   · {ok_count}\n"
                        f"   \u001b[1;31m✗ failed\033[0m · {fail_count}\n"
                        "```",
                        tok)
            threading.Thread(target=_sr, daemon=True).start()
            return

        if cl.startswith("unfrnd ") or cl.startswith("unfriend "):
            ids = re.findall(r"\d+", c)
            if not ids:
                send(cid, "usage: `xunfrnd @user1,@user2`", tok=tok, priority=0); return
            def _uf():
                ok_count = 0; fail_count = 0
                mid_ = _direct_send(
                    cid,
                    f"```ansi\n\u001b[1;33m▸ removing {len(ids)} friend(s)...\u001b[0m\n```",
                    tok)
                for i, uid in enumerate(ids):
                    ok, info = remove_friend(uid, tok)
                    if ok: ok_count += 1
                    else: fail_count += 1
                    if mid_:
                        _direct_edit(
                            cid, mid_,
                            "```ansi\n"
                            "\u001b[1;35m▸ UNFRND · working\u001b[0m\n"
                            f"   user  · \u001b[1;33m{i+1}/{len(ids)}\u001b[0m\n"
                            f"   \u001b[1;32m✓ removed\033[0m · {ok_count}\n"
                            f"   \u001b[1;31m✗ failed\033[0m  · {fail_count}\n"
                            "```",
                            tok)
                    time.sleep(0.8)
                if mid_:
                    _direct_edit(
                        cid, mid_,
                        "```ansi\n"
                        "\u001b[1;35m▸ UNFRND · done\u001b[0m\n"
                        f"   \u001b[1;32m✓ removed\033[0m · {ok_count}\n"
                        f"   \u001b[1;31m✗ failed\033[0m  · {fail_count}\n"
                        "```",
                        tok)
            threading.Thread(target=_uf, daemon=True).start()
            return

        if cl.startswith("gcadd "):
            p = c.split()
            if len(p) < 2:
                send(cid, "usage: `xgcadd @user [all]`", tok=tok, priority=0); return
            uid = get_id_from_mention(p[1])
            if not uid:
                send(cid, "bad user mention/id", tok=tok, priority=0); return
            use_all = len(p) > 2 and p[2].lower() == "all"

            def _ga():
                if not use_all:
                    ok, info = add_user_to_gc(cid, uid, tok)
                    out = ("```ansi\n"
                           "\u001b[1;35m▸ GCADD · done\u001b[0m\n"
                           f"   \u001b[1;36mgc\033[0m    · current\n"
                           f"   \u001b[1;32m✓ added\033[0m · {1 if ok else 0}\n"
                           f"   \u001b[1;31m✗ failed\033[0m · {0 if ok else 1}\n"
                           "```")
                    send(cid, out, tok=tok, priority=0)
                    return

                chans = get_all_group_dms(tok)
                total = len(chans)
                added = 0; failed = 0
                mid_ = _direct_send(
                    cid,
                    f"```ansi\n\u001b[1;33m▸ adding to {total} gc(s)...\u001b[0m\n```",
                    tok)
                for i, ch in enumerate(chans):
                    ok, _ = add_user_to_gc(ch, uid, tok)
                    if ok: added += 1
                    else: failed += 1
                    if mid_:
                        _direct_edit(
                            cid, mid_,
                            "```ansi\n"
                            "\u001b[1;35m▸ GCADD · working\u001b[0m\n"
                            f"   gc    · \u001b[1;33m{i+1}/{total}\u001b[0m\n"
                            f"   \u001b[1;32m✓ added\033[0m  · {added}\n"
                            f"   \u001b[1;31m✗ failed\033[0m · {failed}\n"
                            "```",
                            tok)
                    time.sleep(0.6)
                if mid_:
                    _direct_edit(
                        cid, mid_,
                        "```ansi\n"
                        "\u001b[1;35m▸ GCADD · done\u001b[0m\n"
                        f"   \u001b[1;36mᴛᴏᴛᴀʟ\033[0m     · {total}\n"
                        f"   \u001b[1;32m✓ added\033[0m  · {added}\n"
                        f"   \u001b[1;31m✗ failed\033[0m · {failed}\n"
                        "```",
                        tok)
            threading.Thread(target=_ga, daemon=True).start()
            return

        if cl.startswith("nc "):
            parts, use_all, use_auto = strip_flags(c.split())
            p, dl = parse_delay(parts)
            if len(p) < 2:
                send(cid, "usage: `xnc <text> [delay] [all] [auto]`", tok=tok, priority=0); return
            n = target_name(p[1], tok)
            _nc_origin_chan[tok[:10]] = cid
            if use_auto: _register_auto(tok, "nc", n, dl, flexible=False)
            if use_all:
                cnt = _fanout(nc_on, do_nc, cid, n, tok, dl)
                if cnt: _ack_attack(cid, tok, "nc", n, dl, cnt, use_auto)
                return
            nc_on[k] = True
            threading.Thread(target=do_nc, args=(cid, n, tok, dl), daemon=True).start()
            _ack_attack(cid, tok, "nc", n, dl, auto=use_auto)
            return

        if cl == "stopnc":
            nc_on[k] = False
            _attack_clear(cid)
            send(cid, "```ansi\n\u001b[1;31m▸ NC stopped\u001b[0m\n```", tok=tok, priority=0); return

        if cl.startswith("nc2 "):
            parts, _, _ = strip_flags(c.split())
            p, dl = parse_delay(parts)
            if len(p) < 2:
                send(cid, "usage: `xnc2 <text> [delay]`", tok=tok, priority=0); return
            txt = " ".join(p[1:])
            _nc_origin_chan[tok[:10]] = cid
            nc2_on[k] = True
            threading.Thread(target=do_nc2, args=(cid, txt, tok, dl), daemon=True).start()
            _ack_attack(cid, tok, "nc2", txt, dl)
            return

        if cl == "stopnc2":
            nc2_on[k] = False
            _attack_clear(cid)
            send(cid, "```ansi\n\u001b[1;31m▸ NC2 stopped\u001b[0m\n```", tok=tok, priority=0); return

        if cl.startswith("autonc"):
            parts = c.split()
            if len(parts) < 2:
                send(cid, "usage: `xautonc <text> [delay]`", tok=tok, priority=0); return
            n = target_name(parts[1], tok)
            custom_d = None
            if len(parts) >= 3:
                try:
                    v = float(parts[2])
                    if 0.001 <= v <= 3600:
                        custom_d = v
                except Exception:
                    custom_d = None
            _nc_origin_chan[tok[:10]] = cid
            _register_auto(tok, "nc", n, custom_d, flexible=True)

            if custom_d is not None:
                d_line = f"{custom_d}s \u001b[0;37m(only 1–{NC_CUSTOM_DELAY_MAX_GC} gc)\u001b[0m"
            else:
                d_line = "auto (table)"

            send(cid,
                 "```ansi\n"
                 "\u001b[1;35m▸ AUTONC armed\u001b[0m\n"
                 f"   target · \u001b[1;33m{n}\u001b[0m\n"
                 f"   delay  · \u001b[1;33m{d_line}\u001b[0m\n"
                 f"   \u001b[0;37mabove {NC_CUSTOM_DELAY_MAX_GC} gc the table takes over\u001b[0m\n"
                 "   \u001b[0;37mfires do_nc on every new gc created\u001b[0m\n"
                 "```",
                 tok=tok, priority=0)
            return

        if cl == "stopautonc":
            _clear_auto(tok, "nc")
            send(cid, "```ansi\n\u001b[1;31m▸ AUTONC disarmed\u001b[0m\n```",
                 tok=tok, priority=0); return

        if cl.startswith("customnc "):
            parts, use_all, use_auto = strip_flags(c.split())
            p, dl = parse_delay(parts)
            if len(p) < 2:
                send(cid, "usage: `xcustomnc <text> [delay] [all] [auto]`", tok=tok, priority=0); return
            txt = " ".join(p[1:])
            _nc_origin_chan[tok[:10]] = cid
            if use_all:
                cnt = _fanout(cnc_on, do_cnc, cid, txt, tok, dl)
                if cnt: _ack_attack(cid, tok, "customnc", txt, dl, cnt, use_auto)
                return
            cnc_on[k] = True
            threading.Thread(target=do_cnc, args=(cid, txt, tok, dl), daemon=True).start()
            _ack_attack(cid, tok, "customnc", txt, dl, auto=use_auto)
            return

        if cl == "stopcustomnc":
            cnc_on[k] = False
            _attack_clear(cid)
            send(cid, "```ansi\n\u001b[1;31m▸ CUSTOMNC stopped\u001b[0m\n```", tok=tok, priority=0); return

