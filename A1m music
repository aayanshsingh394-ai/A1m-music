def do_nc(gid, name, tok, delay=None):
    k = f"{gid}_{tok[:10]}"
    d = eff_delay(delay)
    if k not in nc_i: nc_i[k] = 0
    _attack_mark(gid)
    while nc_on.get(k):
        if _nc_wall_wait(k):
            time.sleep(1.0)
            continue
        s = nc_stuff[nc_i[k] % len(nc_stuff)]
        nc_i[k] = (nc_i[k] + 1) % len(nc_stuff)
        base = f"{name}      {s}"
        if len(base) > 50:
            allow = 50 - len("      " + s)
            base = base[:50] if allow < 0 else name[:allow] + "      " + s
        need = 100 - 2 * len(base)
        if need < 0:
            base = base[:50]; need = 100 - 2 * len(base)
        filler = "𒐫" * need
        final = (base + filler + base)[:100]
        rename(gid, final, tok, priority=8, check=lambda k=k: nc_on.get(k), delay=delay)
        time.sleep(d)

